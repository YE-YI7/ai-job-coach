###############################################
# 环境变量示例（复制为 .env.local 并填入真实值）
# .env* 已在 .gitignore 中忽略
###############################################

# ===== Supabase =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_SECRET=generate-at-least-32-random-characters
ADMIN_EMAILS=admin@example.com

# ===== DeepSeek AI =====
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com  (默认值，通常不需要改)
# DEEPSEEK_MODEL=deepseek-v4-flash  (默认值)

# ===== Resend 邮件 =====
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@ai-job-coach.xin

# ===== 观猹 OAuth2 =====
WATCHA_CLIENT_ID=your-watcha-client-id
WATCHA_CLIENT_SECRET=your-watcha-client-secret

# ===== 应用配置 =====
NEXT_PUBLIC_BASE_URL=https://ai-job-coach.xin

# ===== +86 手机短信认证（不是旧 Dysms SendSms） =====
# 密钥由本人从 yizhi-sms-prod 生成，Production/Secret；不要放 NEXT_PUBLIC_。
# 迁移与真实验收完成后才开启；保持 0 不影响原登录方式。
PHONE_AUTH_ENABLED=0
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
# 控制台赠送签名/模板，无需自建签名；可按实际审核结果覆盖。
ALIYUN_PNVS_SIGN_NAME=恒创联众
ALIYUN_PNVS_LOGIN_TEMPLATE=100001
ALIYUN_PNVS_BIND_TEMPLATE=100004
