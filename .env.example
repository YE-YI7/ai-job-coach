###############################################
# 环境变量示例（复制为 .env.local 并填入真实值）
# .env* 已在 .gitignore 中忽略
###############################################

# ===== Supabase =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_SECRET=generate-at-least-32-random-characters
ADMIN_EMAILS=admin@example.com

# ===== DeepSeek AI =====
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com  (默认值，通常不需要改)
# DEEPSEEK_MODEL=deepseek-v4-flash  (默认值)

# ===== Resend 邮件 =====
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@ai-job-coach.xin

# ===== 观猹 OAuth2 =====
WATCHA_CLIENT_ID=your-watcha-client-id
WATCHA_CLIENT_SECRET=your-watcha-client-secret

# ===== 应用配置 =====
NEXT_PUBLIC_BASE_URL=https://ai-job-coach.xin
